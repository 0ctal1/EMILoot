{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "EMI Loot",
  "description": "shows chest loot, block drops, mob drops, and ore distribution inside EMI",
  "authors": [
    "0ctal"
  ],
  "contact": {
    "sources": "https://github.com/0ctal1/EMILoot"
  },
  "license": "ARR",
  "icon": "assets/emi_loot/icon.png",
  "environment": "client",
  "entrypoints": {
    "btw:addon": [
      "btw.community.emiloot.EmiLootAddon"
    ],
    "emi": [
      "btw.community.emiloot.emi.EmiLootPlugin"
    ]
  },
  "custom": {
    "btw:addon_prefix": "EL"
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.19",
    "minecraft": "${minecraft_version}",
    "btw": "*"
  }
}
